# Application Configuration
APP_NAME="Akibworks Expense Tracker"
APP_URL="https://expense.akibworks.in"
APP_ENV="production"

# Database Configuration (optional - for MySQL backend)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="expense_tracker"
DB_USER="root"
DB_PASSWORD="your_secure_password_here"

# Security
SESSION_TIMEOUT=3600
SECURE_COOKIES=true
HTTPS_ONLY=true

# Email Configuration (for future features)
MAIL_FROM="noreply@yourdomain.com"
MAIL_HOST="smtp.example.com"
MAIL_PORT="465"
MAIL_USERNAME="your_email@example.com"
MAIL_PASSWORD="your_email_password"
MAIL_ENCRYPTION="ssl"

# SEO & Branding
SITE_TITLE="Akibworks Expense Tracker"
SITE_DESCRIPTION="A simple, intuitive expense tracking application with guest mode and user authentication."
SITE_KEYWORDS="expense tracker, budget management, spending tracker"
SITE_AUTHOR="Akibworks"

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Logging
LOG_LEVEL="error"
LOG_PATH="/var/log/expense-tracker/"
